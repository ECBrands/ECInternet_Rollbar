<?xml version="1.0"?>
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp/etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <value id="rollbar-cdn" type="host">https://cdn.rollbar.com</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="rollbar-api" type="host">https://api.rollbar.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
